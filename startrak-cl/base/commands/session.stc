# Starttrak command format version 1.0
# Header (name + arg:type:default)
session -new:str -mode:str -scan-dir:str --v:int:0

# Documentation
<!DOC>
Usage:
 session -new NAME -mode [inspect, scan]

Decsription:
 Displays or creates a new session with the given name and session mode.

 If no arguments are given it will print the current session name, if $--v$ is given, then it will recursively print the elements of the current session, the recursion depth can be defined by passing a positive integer after --v.

 If $-new$ is given, then the name of the new session must be followed. Names containing a space should be encolosed using double quotes.
 By default $-mode$ is set to $inspect$, you can currently select two options: $inspect$ and $scan$.

 inspect: Creates a new inspection session to read and analyse local stored files
 scan: Creates a session that will constanly read changes from a given directory, if this option is selected then passing a proper $-scan-dir$ is mandatory.
<!END>

# Python-like code
<!BODY>
import os
session = get_session()

if $new:
	match $mode:
		case None:
			session = new_session($new, 'inspect')
		case 'inspect' | 'insp' | 'InspectionSession':
			session = new_session($new, 'inspect')
		case 'scan' | 'ScanSession':
			dir = $scan-dir
			if not dir:
				dir = os.getcwd()
			session = new_session($new, 'scan', dir)
		case _:
			raise STException(f'Unknown mode "{$mode}"')
else:
	if not session:
		raise STException('There is no session created, use the "-new" keyword to create one.')

if $v != None:
	print(session.__pprint__(0, $v))
return ReturnInfo(session.name, text= get_text(session.__pprint__, 0, $v if $v else 4), obj= session)

<!END>