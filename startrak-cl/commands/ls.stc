# Startrak command format version 1.0
# Header (name + arg:type:default)
ls $0:path:* -a:bool -r:bool

# Documentation
<!DOC>
Usage:
	ls PATTERN

Description:
	List files matching the pattern provided by $PATTERN$. By default lists the files inside the current working directory.
<!END>

<!BODY>
import os
import glob

print($0, $a, $r)
if os.path.isfile($0):
	ERROR f"{$0} is a file."
if not $0.endswith('*'):
	$0 = $0 + '/*'

cwd = os.getcwd() + '/'
files_iterator = glob.iglob($0, root_dir= cwd, include_hidden= $a)

if not files_iterator:
	ERROR  "No files match the pattern."

for file in files_iterator:
	file = file.replace('\\', '/')
	if os.path.isdir(file):
		print(file + '/')
	else:
		print(file)
<!END>