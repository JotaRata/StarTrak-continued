# Startrak command format version 1.0
# Header (name + arg:type:default)
ls $0:path:. --cols:int:0 -l:bool

# Documentation
<!DOC>
%Usage:%
ls PATTERN

%Description:%
List files matching the pattern provided by $PATTERN$. By default lists the files inside the current working directory.
<!END>

<!INCLUDE>
import os
import stat
import time
<!END>

<!BODY>
def list_columns(buffer, paths, columns):
	max_length = max([len(file) for (file, _) in paths])
	if columns == 0:
		columns = console.width // max_length
	col_width = console.width // columns

	col_chars = 0
	for file, is_dir in paths:
		if ' ' in file:
			file = f"'{file}'"
		file = file.ljust(col_width)
		if col_chars + col_width <= console.width:
			col_chars += col_width + 1
		else:
			buffer.write('\n')
			col_chars = 0
		buffer.write(console.format(file, 'blue' if is_dir else 'green'))
	buffer.write('\n' * 2)

def list_stats(buffer, paths, directory):
	buffer.write(f'Total: {len(paths)}\n')
	columns = list[str]()
	for file, is_dir in paths:
		stats = os.stat(f'{directory}/{file}')
		if ' ' in file:
			file = f"'{file}'"
		
		columns.append( stat.filemode(stats.st_mode) )
		columns.append( str(stats.st_uid) )
		columns.append( str(stats.st_gid) )
		columns.append( str(stats.st_size) )
		columns.append( time.ctime(stats.st_mtime) )
		buffer.write(' '.join( (str.rjust(col, 8) for col in columns) ) + ' ')
		buffer.write(console.format(file, 'blue' if is_dir else 'green'))
		
		buffer.write('\n')
		columns.clear()
	buffer.write('\n')

cwd = os.getcwd()
paths = dict[str, list]()

match $0:
	case None:
		paths[cwd] = [(e.name, e.is_dir()) for e in os.scandir(cwd)]
	case [path]:
		if not os.path.exists(path):
			ERROR 'Path not found'
		paths[path] = [(e.name, e.is_dir()) for e in os.scandir(path)]
	case _:
		for entry in $0:
			dir_name = os.path.dirname(entry)
			if len(dir_name) == 0:
				dir_name = '.'
			rel = os.path.relpath(entry, dir_name)
			is_dir = os.path.isdir(entry)
			if dir_name not in paths:
				paths[dir_name] = [(rel, is_dir)]
			else:
				paths[dir_name].append((rel, is_dir))

if $printable:
	buffer = console.buffer()
	for dir in paths:
		if os.name == 'nt':
			dir = dir.replace(r'\\', '/')	
		if len(paths) > 1:
			buffer.write(f'{dir}: \n')

		if not $l:
			list_columns(buffer, paths[dir], $cols)
		else:
			list_stats(buffer, paths[dir], dir)
	console.write(buffer.getvalue())

def text_generator_method(paths):
	for path in paths.values():
		for p in path:
			yield p[0]
text_generator = text_generator_method(paths)
RETURN TEXT str.join('\n', text_generator)
		
<!END>