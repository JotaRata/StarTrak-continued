# Startrak command format version 1.0
# Header (name + arg:type:default)
ls $0:path:. --cols:int:6

# Documentation
<!DOC>
Usage:
	ls PATTERN

Description:
	List files matching the pattern provided by $PATTERN$. By default lists the files inside the current working directory.
<!END>

<!BODY>
import os
from io import StringIO

cwd = os.getcwd()
paths = dict[str, list]()

match $0:
	case None:
		paths['.'] = [(e.name, e.is_dir()) for e in os.scandir(cwd)]
	case [path]:
		if not os.path.exists(path):
			ERROR 'Path not found'
		paths['.'] = [(e.name, e.is_dir()) for e in os.scandir(path)]
	case _:
		for entry in $0:
			dir_name = os.path.dirname(entry)
			rel = os.path.relpath(entry, dir_name)
			is_dir = os.path.isdir(entry)
			if dir_name not in paths:
				paths[dir_name] = [(rel, is_dir)]
			else:
				paths[dir_name].append((rel, is_dir))
col_width = console.width // $cols
buffer = StringIO()

for dir in paths:
	if os.name == 'nt':
		dir = dir.replace(r'\\', '/')	
	if len(paths) > 1:
		buffer.write(f'{dir}: \n')

	col_chars = 0
	long_names = list[str]()
	for file, is_dir in paths[dir]:
		if len(file) > col_width:
			long_names.append(console.format(file, 'blue' if is_dir else 'green'))
			continue
		if ' ' in file:
			file = f"'{file}'"
		file = file.ljust(col_width)
		if col_chars + col_width <= console.width:
			col_chars += col_width + 1
		else:
			buffer.write('\n')
			col_chars = 0
		buffer.write(console.format(file, 'blue' if is_dir else 'green'))

	buffer.write('\n' + '\n'.join(long_names))
	buffer.write('\n' * 2)

print(buffer.getvalue())
RETURN TEXT buffer.getvalue()
RETURN PATH paths.values()
		
<!END>