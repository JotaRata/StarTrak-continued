# Startrak command format version 1.0
# Header (name + arg:type:default)
ls $0:path:. --cols:int:80 --sep:int:8

# Documentation
<!DOC>
Usage:
	ls PATTERN

Description:
	List files matching the pattern provided by $PATTERN$. By default lists the files inside the current working directory.
<!END>

<!BODY>
import os
from io import StringIO

cwd = os.getcwd()
paths = dict[str, list]()

match $0:
	case None:
		paths['.'] = [e.name for e in os.scandir(cwd)]
	case [path]:
		if not os.path.exists(path):
			ERROR 'Path not found'
		paths['.'] = [e.name for e in os.scandir(path)]
	case _:
		for entry in $0:
			dir_name = os.path.dirname(entry)
			rel = os.path.relpath(entry, dir_name)
			if dir_name not in paths:
				paths[dir_name] = [rel]
			else:
				paths[dir_name].append(rel)
spaces = ' ' * $sep
for dir in paths:
	if os.name == 'nt':
		dir = dir.replace(r'\\', '/')	
	if len(paths) > 1:
		print(f'\n{dir}: ')

	buffer = StringIO()
	col_chars = 0
	for file in paths[dir]:
		if ' ' not in file:
			buffer.write(file)
		else:
			buffer.write(f"'{file}'")
		if col_chars + (acc:= len(file) + len(spaces)) < $cols:
			buffer.write(spaces)
			col_chars += acc
		else:
			buffer.write('\n')
			col_chars = 0
	print(buffer.getvalue())
		
<!END>